#!/bin/sh

# PROVIDE: joplin
# REQUIRE: DAEMON NETWORKING
# KEYWORD: shutdown

# Add the following lines to /etc/rc.conf to enable joplin
#
# joplin_enable (bool):   set to NO by default
# joplin_config (string): optional full path to joplin.conf
# joplin_user   (string): optional user to run as
# joplin_group  (string): optional user to run as

. /etc/rc.subr

name="joplin"
rcvar="joplin_enable"

load_rc_config $name

: ${joplin_enable="NO"}
: ${joplin_config:="%%ETCDIR%%/joplin.conf"}
: ${joplin_user:="joplin"}
: ${joplin_group:="joplin"}
: ${joplin_appdir="%%LOCALBASE%%/libexec/joplin-server/packages/server/dist/"}
: ${joplin_chdir="%%LOCALBASE%%/libexec/joplin"}
: ${joplin_logfile="/var/log/joplin.log"}

pidfile="/var/run/${name}/${name}.pid"
joplin_nodejs_pidfile="/var/run/${name}/${name}.node"
joplin_env="NODE_ENV=production"

start_precmd="joplin_start_precmd"
start_cmd="joplin_start_cmd"
stop_cmd="joplin_stop_cmd"

required_files="${joplin_config}"

command="/usr/local/bin/node"
command_args=${joplin_appdir}"/app.js --envFile="${joplin_config}
procname="${name}"

joplin_start_cmd()
{
    echo "Starting ${name}"
    /usr/sbin/daemon \
        -t joplin -T joplin \
        -P ${pidfile} \
        -p ${joplin_nodejs_pidfile} \
        -o ${joplin_logfile} \
        -r -R 15 \
        ${command} ${command_args}
}

joplin_start_precmd()
{
    if [ ! -d "/var/run/${name}" ]; then
        install -d -m 0750 -o ${joplin_user} -g ${joplin_group} "/var/run/${name}"
        install -o ${joplin_user} /dev/null ${pidfile}
        install -o ${joplin_user} /dev/null ${joplin_nodejs_pidfile}
    fi
}

joplin_stop_cmd()
{
    if [ -f "${pidfile}" ]; then
        kill "$(cat "${pidfile}")" 2>/dev/null
        rm -f ${pidfile}
        echo "${name} stopped"
    else
        echo "${name} is not running."
    fi

}

run_rc_command "$1"

